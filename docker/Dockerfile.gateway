FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /build

COPY miniapp-delivery/docker/pom-gateway.xml ./miniapp-deploy/pom.xml
COPY miniapp-gateway ./miniapp-gateway
RUN mvn -f miniapp-gateway/pom.xml -DskipTests package

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /build/miniapp-gateway/target/*.jar app.jar
EXPOSE 8080
ENV JAVA_OPTS="-Xms128m -Xmx512m"
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
