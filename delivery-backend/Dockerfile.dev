# Dev-сборка: кэш Maven-зависимостей отдельно от исходников.
# Production использует Dockerfile без изменений.
# Без # syntax=docker/dockerfile:1 — не тянет отдельный BuildKit-образ с Docker Hub.
# ~/.m2 сохраняется в слое go-offline и переиспользуется шагом package.

FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /build

# Слой 1: только pom.xml — пересобирается при изменении зависимостей
COPY pom.xml .

# Слой 2: скачивание зависимостей (кэшируется, пока pom.xml не менялся)
RUN mvn -B -ntp -f pom.xml dependency:go-offline -DskipTests

# Слой 3: исходники — инвалидирует только компиляцию, не зависимости
COPY src ./src

# Слой 4: сборка без тестов, .m2 уже в образе из слоя 2
RUN mvn -B -ntp -f pom.xml -DskipTests package

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /build/target/*.jar app.jar
EXPOSE 9081
ENV JAVA_OPTS="-Xms256m -Xmx768m"
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
